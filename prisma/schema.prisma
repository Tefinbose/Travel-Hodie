generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
    provider = "mysql"
}

enum UserRole {
     ADMIN
     STAFF
}

enum EnquiryStatus {
  PENDING
  CONTACTED
  CONFIRMED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Destination {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  country     String?
  image       String?
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  packages    Package[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Package {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  shortDescription String?     @db.Text
  description   String         @db.LongText
  destinationId String
  destination   Destination    @relation(fields: [destinationId], references: [id])
  duration      String
  price         Decimal        @db.Decimal(10, 2)
  image         String?
  isFeatured    Boolean        @default(false)
  isActive      Boolean        @default(true)
  images        PackageImage[]
  enquiries     Enquiry[]
  bookings      Booking[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt


  @@index([destinationId])
  @@index([isActive, isFeatured])
}

model PackageImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([packageId])
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  message   String        @db.Text
  status    EnquiryStatus @default(PENDING)
  packageId String?
  package   Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([packageId])
}

model Booking {
  id            String             @id @default(cuid())
  bookingNumber String             @unique
  customerName  String
  email         String
  phone         String
  travelDate    DateTime?
  totalAmount   Decimal            @db.Decimal(10, 2)
  status        BookingStatus      @default(PENDING)
  packageId     String?
  package       Package?           @relation(fields: [packageId], references: [id], onDelete: SetNull)
  passengers    BookingPassenger[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([email])
}

model BookingPassenger {
  id        String   @id @default(cuid())
  name      String
  age       Int?
  gender    String?
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  icon        String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String?
  message   String   @db.Text
  rating    Int      @default(5)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}